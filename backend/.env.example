# Environment Variables — LinkedIn AI Reply Backend
# ===================================================
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file to version control.

# ── Required ──────────────────────────────────────────────────────────────────

# Your Google Gemini API key.
# Get one at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Optional (defaults shown) ─────────────────────────────────────────────────

# Gemini model to use for reply generation and conversation analysis.
# gemini-2.5-flash is fast and cost-efficient for this use case.
GEMINI_MODEL=gemini-3.6-flash

# Enable FastAPI debug mode (more verbose errors in /docs).
# Set to false in production.
DEBUG=false

# ── CORS Origins (optional override) ─────────────────────────────────────────
# Comma-separated list of allowed origins for the Chrome extension.
# Defaults are set in app/core/config.py for localhost development.
# To add the production extension origin, set this in production .env:
# CORS_ORIGINS=["http://localhost:3000","chrome-extension://your-extension-id"]
