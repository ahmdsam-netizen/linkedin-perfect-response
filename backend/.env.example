# Environment Variables — LinkedIn AI Reply Backend V2
# =====================================================
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file to version control.

# ── Required ──────────────────────────────────────────────────────────────────

# Your Google Gemini API key.
# Get one at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-api-key

# PostgreSQL connection string (V2 required)
# Using Docker Compose: run `docker compose up -d` then use the URL below.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/linkedin_reply

# ── Optional (defaults shown) ─────────────────────────────────────────────────

# Gemini model for reply generation and memory extraction.
GEMINI_MODEL=gemini-3.6-flash

# Gemini embedding model (gemini-embedding-001 with 768-dim Matryoshka truncation).
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768

# Memory processing thresholds
MEMORY_PROCESS_THRESHOLD=10   # Process memory after N unprocessed messages
RECENT_MESSAGES_COUNT=8       # Recent messages included in reply context
RETRIEVAL_TOP_K=3             # Max facts returned by semantic search
RETRIEVAL_THRESHOLD=0.30      # Minimum cosine similarity score (0.0 to 1.0)

# Enable FastAPI debug mode.
DEBUG=false

# ── CORS Origins ─────────────────────────────────────────────────────────────
# Add your Chrome extension origin in production:
# CORS_ORIGINS=["http://localhost:3000","chrome-extension://your-extension-id"]
